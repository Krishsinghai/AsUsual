<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/admin/edit-poster" method="POST" enctype="multipart/form-data">
        <!-- Image 1 -->
        <label for="poster1">Upload Image 1:</label>
        <input type="file" id="poster1" name="poster1" accept="image/*" required><br><br>
        <label for="Heading1">Heading 1:</label>
        <input type="text" id="Heading1" name="Heading1" required><br><br>
        <label for="Title1">Title 1:</label>
        <input type="text" id="Title1" name="Title1" required><br><br>

        <!-- Image 2 -->
        <label for="poster2">Upload Image 2:</label>
        <input type="file" id="poster2" name="poster2" accept="image/*" required><br><br>
        <label for="Heading2">Heading 2:</label>
        <input type="text" id="Heading2" name="Heading2" required><br><br>
        <label for="Title2">Title 2:</label>
        <input type="text" id="Title2" name="Title2" required><br><br>

        <!-- Image 3 -->
        <label for="poster3">Upload Image 3:</label>
        <input type="file" id="poster3" name="poster3" accept="image/*" required><br><br>
        <label for="Heading3">Heading 3:</label>
        <input type="text" id="Heading3" name="Heading3" required><br><br>
        <label for="Title3">Title 3:</label>
        <input type="text" id="Title3" name="Title3" required><br><br>

        <button type="submit" class="submit">Submit</button>
    </form>
</body>
</html>