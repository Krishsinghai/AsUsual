<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      background-color: #000;
      color: aliceblue;
      text-align: center;
      padding: 1rem;
      overflow: hidden;
    }

    .upper img {
      width: 30rem;
      margin-left: -7rem;
      margin-top: 1rem;
      max-width: 100%;
    }

    .upper .heading {
      border-left: 2px solid #fff;
      padding-left: 10px;
    }

    h3 {
      font-size: 3rem;
    }

    .heading2 {
      margin-left: 20rem;
    }

    .heading1 {
      margin-left: 18rem;
    }

    .lower h3 {
      margin-left: 40rem;
    }

    .lower p {
      font-size: 1.4rem;
    }

    .lower-para {
      border-right: 2px solid #fff;
      padding-right: 20px;
    }

    .lower {
      padding-left: 15rem;
      padding-right: 15rem;
    }

    .tagline {
      font-size: 2rem;
      margin-top: 2rem;
      width: fit-content;
      padding-bottom: 1rem;
      border-bottom: 2px solid #fff;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      h3 {
        font-size: 2rem;
      }

      .heading1 {
        margin-left: 6rem;
      }

      .heading2 {
        margin-left: 10rem;
      }

      .upper img {
        width: 22rem;
        margin-left: -4rem;
        margin-top: 1rem;
      }

      .lower {
        padding: 1rem;
      }

      .tagline {
        font-size: 1.5rem;
      }

      .lower h3 {
        margin-left: 25rem;
      }
    }

    @media (max-width: 480px) {
      h3 {
        font-size: 1.8rem;
      }

      .heading {
        padding-left: 6px;
      }

      .heading1 {
        margin-left: 0;
      }

      .heading2 {
        margin-left: 5rem;
      }

      .upper img {
        width: 17rem;
        margin-left: 0;
        margin-top: 1rem;
      }

      .lower {
        width: 95%;
      }

      .lower p {
        font-size: 0.9rem;
      }

      .tagline {
        font-size: 1.3rem;
      }
      .lower h3 {
        margin-left: 5rem;
        margin-top: 1rem;
        margin-bottom: 1rem;
    }
    }
  </style>
</head>

<body>
  
  <div class="container">
    <div class="upper">
      <div class="heading">
        <h3 class="heading1">FASHION</h3>
        <h3 class="heading2">ENTHUSIAST</h3>
      </div>
      <img src="/assests/horizontalLogo-removebg-preview.png" alt="Logo">
    </div>
    <div class="lower">
      <h3>Who are we?</h3>
      <div class="lower-para">
        <p>
          As Usual is a unisex street-style clothing brand designed for the youth
          who love to express themselves through fashion — effortlessly cool,
          comfortably bold. We blend casual vibes with street-inspired designs,
          making every outfit a statement.
        </p>
        <h2 class="tagline">Style it casual, As Usual.</h2>
      </div>
    </div>
  </div>
</body>

</html>
