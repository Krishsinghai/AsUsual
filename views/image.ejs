<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Upload Product</title>
        <style>
            /* General Styling */
            body {
                font-family: Arial, sans-serif;
                background-color: #f5f5f5;
                margin: 0;
                padding: 0;
                text-align: center;
            }

            .product_form {
                margin: 20px auto;
                padding: 20px;
                max-width: 500px;
                background-color: #ffffff;
                border-radius: 10px;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            }

            input, textarea, button {
                width: 100%;
                padding: 10px;
                margin: 10px 0;
                border: 1px solid #ddd;
                border-radius: 5px;
            }

            button {
                background-color: #007bff;
                color: #fff;
                font-size: 16px;
                cursor: pointer;
                border: none;
            }

            button:hover {
                background-color: #0056b3;
            }

            h2 {
                margin: 20px 0;
                color: #333;
            }

            /* Masonry Layout Styling */
            #imageContainer {
                margin: 20px;
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 15px;
                justify-content: center;
            }

            #imageContainer div {
                background-color: #ffffff;
                border-radius: 10px;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
                overflow: hidden;
                padding: 10px;
                text-align: left;
            }

            #imageContainer img {
                width: 100%;
                border-radius: 10px;
                display: block;
            }

            #imageContainer h3 {
                font-size: 18px;
                margin: 10px 0 5px;
                color: #333;
            }

            #imageContainer p {
                margin: 5px 0;
                font-size: 14px;
                color: #666;
            }
        </style>
    </head>
    <body>
        <div class="product_form">
            <h1>Product Uploader</h1>
            <form id="productForm" enctype="multipart/form-data" method="POST" action="/upload">
                <input type="text" name="name" placeholder="Product Name" required><br><br>
                <textarea name="description" placeholder="Product Description" required></textarea><br><br>
                <input type="number" name="price" placeholder="Price" step="0.01" required><br><br>
                <input type="text" name="brand" placeholder="Brand"><br><br>
                <input type="number" name="stock" placeholder="Stock Quantity" min="0" required><br><br>
                <input type="file" name="images" id="imageInput" multiple><br><br>
                <button type="submit">Upload Product</button>
            </form>
        </div>

        <h2>Uploaded Products</h2>
        <div id="imageContainer">
            <% products.forEach(product => { %>
            <div>
                <h3><%= product.name %></h3>
                <p><%= product.description %></p>
                <p>Price: $<%= product.price %></p>
                <p>Brand: <%= product.brand %></p>
                <p>Stock: <%= product.stock %></p>
                <div>
                    <% product.images.forEach(image => { %>
                    <img src="<%= image %>" alt="<%= product.name %>">
                    <% }); %>
                </div>
            </div>
            <% }); %>
        </div>
    </body>
</html>
