<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"> <!-- Sets the character encoding to UTF-8 for the page -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Ensures responsive design on all devices -->
    <title>Upload and Display Images</title>
    <style>
        /* General body styling */
        body {
            font-family: Arial, sans-serif; /* Font style for the entire page */
            text-align: center; /* Centers all text and elements */
            padding: 20px; /* Adds padding around the content */
        }

        /* Styling for the file input */
        input[type="file"] {
            margin: 20px 0; /* Adds space above and below the file input */
        }

        /* Container for displaying uploaded images */
        #imageContainer {
            display: flex; /* Enables flexible layout for the container */
            flex-wrap: wrap; /* Ensures images wrap to the next row if needed */
            justify-content: center; /* Centers the images horizontally */
            gap: 10px; /* Adds spacing between images */
            margin-top: 20px; /* Adds space above the container */
        }

        /* Styling for individual images */
        img {
            width: 200px; /* Sets a fixed width for all images */
            height: auto; /* Maintains aspect ratio of the images */
            border: 2px solid #ddd; /* Adds a light border around images */
            border-radius: 8px; /* Adds rounded corners to images */
        }
    </style>
</head>
<body>
    <h1>Upload and Display Images</h1> <!-- Page heading -->

    <!-- Form for uploading images -->
    <form id="uploadForm">
        <input type="file" id="imageInput" name="images" multiple> <!-- File input to allow multiple file selection -->
        <button type="submit">Upload Images</button> <!-- Submit button for the form -->
    </form>

    <div id="status"></div> <!-- Div to display status messages (success/error) -->

    <!-- Container for displaying uploaded images -->
    <div id="imageContainer">
        <% images.forEach(image => { %> <!-- Loop through the images passed from the server -->
            <img src="data:image/png;base64,<%= image.data %>" alt="<%= image.name %>"> <!-- Render each image using Base64 data -->
        <% }); %>
    </div>

    <script>
        const uploadForm = document.getElementById('uploadForm'); // Form element for image upload
        const imageContainer = document.getElementById('imageContainer'); // Container where images are displayed
        const statusDiv = document.getElementById('status'); // Div for showing status messages

        // Handle form submission to upload images
        uploadForm.addEventListener('submit', (event) => {
            event.preventDefault(); // Prevents the default form submission (page reload)
            
            const input = document.getElementById('imageInput'); // Get the file input element
            const files = input.files; // Get the selected files
            if (!files.length) {
                // If no files are selected, show a message
                statusDiv.textContent = 'Please select at least one image.';
                return;
            }

            const formData = new FormData(); // Create a new FormData object
            Array.from(files).forEach(file => formData.append('images', file)); // Add all selected files to FormData

            // Send the images to the server using the Fetch API
            fetch('/upload', {
                method: 'POST', // HTTP POST method
                body: formData, // Send the FormData object as the request body
            })
                .then(response => response.json()) // Parse the JSON response
                .then(data => {
                    // Show the success message from the server
                    statusDiv.textContent = data.message || 'Images uploaded successfully!';
                    location.reload(); // Reload the page to display the uploaded images
                })
                .catch(err => {
                    // Handle errors during the fetch process
                    statusDiv.textContent = 'Error uploading images.';
                    console.error('Error:', err); // Log the error in the console for debugging
                });
        });
    </script>
</body>
</html>