<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Get in touch with us for any questions or feedback. We'd love to hear from you!">
  <meta property="og:title" content="Contact Us">
  <meta property="og:description" content="Contact us for inquiries, feedback, or collaboration.">
  <meta property="og:image" content="path-to-your-image.jpg">
  <meta property="og:url" content="https://yourwebsite.com/contact">
  <title>Contact Us</title>
  <link rel="stylesheet" href="styles/contantUs.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <section id="contact">
    <div class="container">
      <h1 class="section-title">Get In Touch</h1>
      <p class="section-subtitle">We'd love to hear from you! Fill out the form or reach out via the details below.</p>

      <!-- Contact Form -->
      <div class="contact-content">
        <form id="contact-form" class="contact-form" action="/contact" method="post">
          <div class="form-group">
            <input type="text" id="name" name="name"  placeholder="Your Name" required>
          </div>
          <div class="form-group">
            <input type="email" id="email" name="email"  placeholder="Your Email" required>
          </div>
          <div class="form-group">
            <textarea id="message"  name="message" rows="5" placeholder="Your Message" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Send Message</button>
        </form>

        <!-- Contact Details -->
        <div class="contact-info">
          <h2>Contact Information</h2>
          <ul class="info-list">
            <li><i class="fas fa-map-marker-alt"></i> Near sasta bhandar, Kolar, Bhopal, Madhya Pradesh, India</li>
            <li><i class="fas fa-phone"></i> <a href="tel:+1234567890">8233377117</a></li>
            <li><i class="fas fa-envelope"></i> <a href="mailto:hitmeup@gmail.com">asusualclothing@gmail.com</a></li>
          </ul>

          <!-- Social Media Links -->
          <div class="social-media">
            <h3>Follow Us</h3>
            <ul class="social-list">
              <li><a href="https://www.instagram.com/as_usual.clothing/" target="_blank"><i class="fab fa-instagram"></i></a></li>
              <li><a href="https://www.instagram.com/as_usual.clothing/" target="_blank"><i class="fab fa-facebook"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</body>
</html>