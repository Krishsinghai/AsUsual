<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Privacy Policy | As Usual Clothing</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  
  <link rel="stylesheet" href="styles/styles.css">
  <link rel="stylesheet" href="styles/footer.css">
  <link rel="stylesheet" href="styles/navbar.css">
</head>
<body class="min-h-screen bg-[#444] text-white font-sans">

  <!-- Header -->
  <header class="w-full bg-gray-800 py-6 text-center">
    <h1 class="text-4xl font-bold">Privacy Policy</h1>
  </header>

  <!-- Main Content -->
  <main id="policyContent" class="max-w-5xl mx-auto px-4 py-10">
    
    <!-- Section 1 -->
    <section class="bg-gray-600 p-6 rounded-t-2xl">
      <h2 class="text-2xl font-semibold mb-3">1. Data Collection</h2>
      <ul class="list-disc list-inside space-y-1">
        <li>Name, phone number, and shipping address for order processing.</li>
        <li>Email and social media interactions for customer support.</li>
      </ul>
    </section>

    <!-- Section 2 -->
    <section class="bg-gray-700 p-6">
      <h2 class="text-2xl font-semibold mb-3">2. Use of Information</h2>
      <ul class="list-disc list-inside space-y-1">
        <li>Process and ship orders.</li>
        <li>Send order confirmations and updates.</li>
        <li>Provide customer support and promotions.</li>
      </ul>
    </section>

    <!-- Section 3 -->
    <section class="bg-gray-600 p-6">
      <h2 class="text-2xl font-semibold mb-3">3. Data Protection & Security</h2>
      <ul class="list-disc list-inside space-y-1">
        <li>We do not sell, rent, or share your personal information with third parties, except for order fulfillment purposes.</li>
        <li>We implement industry-standard security measures to protect your data.</li>
        <li>No method of online transmission or storage is 100% secure, so we cannot guarantee absolute security.</li>
      </ul>
    </section>

    <!-- Section 4 -->
    <section class="bg-gray-700 p-6">
      <h2 class="text-2xl font-semibold mb-3">4. Cookies & Tracking</h2>
      <ul class="list-disc list-inside space-y-1">
        <li>We may use cookies to improve your user experience on the website.</li>
      </ul>
    </section>

    <!-- Section 5 -->
    <section class="bg-gray-600 p-6">
      <h2 class="text-2xl font-semibold mb-3">5. Third-Party Links</h2>
      <ul class="list-disc list-inside space-y-1">
        <li>Our website may include links to third-party websites.</li>
        <li>We are not responsible for their privacy practices or content.</li>
        <li>Please review their privacy policies before sharing information.</li>
      </ul>
    </section>

    <!-- Section 6 -->
    <section class="bg-gray-700 p-6 rounded-b-2xl">
      <h2 class="text-2xl font-semibold mb-3">6. Updates to Privacy Policy</h2>
      <ul class="list-disc list-inside space-y-1">
        <li>This policy may be updated periodically.</li>
        <li>We recommend reviewing it regularly to stay informed.</li>
      </ul>
    </section>

    <!-- Download Button -->
    <div class="text-center mt-10">
      <button onclick="downloadPDF()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl shadow-lg transition duration-300">
        Download PDF
      </button>
    </div>

  </main>

  <!-- PDF Script -->
  <script>
    async function downloadPDF() {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();

      let content = document.getElementById('policyContent').innerText;

      const lines = doc.splitTextToSize(content, 180);
      doc.text(lines, 15, 20);

      doc.save('Privacy_Policy_AsUsual.pdf');
    }
  </script>

</body>
</html>