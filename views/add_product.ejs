<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product</title>
    <link rel="stylesheet" href="/styles/add_product.css">
    <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
    <h1>Add Product</h1>
    <form action="/admin/logout" method="POST">
        <button type="submit" class="logout">Logout</button>
    </form>
    <form action="/add-product" method="POST" enctype="multipart/form-data">
        <label for="name">Product Name:</label>
        <input type="text" id="name" name="name" required><br><br>

        <label for="description">Description:</label>
        <textarea id="description" name="description" required></textarea><br><br>

        <label for="price">Price:</label>
        <input type="number" id="price" name="price" step="0.01" required><br><br>

        <label for="brand">Brand:</label>
        <input type="text" id="brand" name="brand" placeholder="AsUsual"><br><br>

        <label for="color">Color:</label>
        <input type="text" id="color" name="color" placeholder="Color"><br><br>

        <label for="category">Category:</label>
        <select id="category" name="category">
            <option value="">Select Category</option>
            <option value="Regular">Regular</option>
            <option value="Oversized">Oversized</option>
        </select><br><br>

        <label for="xsmall">x-Small Quantity:</label>
        <input type="number" id="x-small" name="sizes[xsmall]" min="0" value="0"><br><br>

        <label for="small">Small Quantity:</label>
        <input type="number" id="small" name="sizes[small]" min="0" value="0"><br><br>

        <label for="medium">Medium Quantity:</label>
        <input type="number" id="medium" name="sizes[medium]" min="0" value="0"><br><br>

        <label for="large">Large Quantity:</label>
        <input type="number" id="large" name="sizes[large]" min="0" value="0"><br><br>

        <label for="xlarge">x-Large Quantity:</label>
        <input type="number" id="xlarge" name="sizes[xlarge]" min="0" value="0"><br><br>
        
        <label for="front_image">Front image</label>
        <input type="file" id="front_image" name="front_images" required><br><br>
        
        <label for="back_image">Back image</label>
        <input type="file" id="back_image" name="back_image" required><br><br>

        <label for="images">Upload Images (Max 5):</label>
        <input type="file" id="images" name="images" multiple accept="image/*" required><br><br>

        <button type="submit">Add Product</button>
    </form>
</body>
</html>
