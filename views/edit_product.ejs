<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Products</title>
    <link rel="stylesheet" href="/styles/edit_product.css">
</head>
<body>
    <h1>Edit Products</h1>
    <form action="/admin/logout" method="POST" >
        <button type="submit" class="logout">Logout</button>
    </form>
    <% products.forEach(product => { %>
        <div class="product">
            <h2 class="product-name"><%= product.name %></h2>
            <% if (product.front_image) { %>
                <img src="<%= product.front_image %>" alt="Product Image" class="product-image">
            <% } %>
            <form action="/edit_product/<%= product._id %>" method="POST" class="edit-form">
                <label>product name:</label>
                <input class="input-field" type="text" name="name" value="<%= product.name %>">
                <label>price:</label>
                <input class="input-field" type="number" name="price" value="<%= product.price %>">
                <label>brand name:</label>
                <input class="input-field" type="text" name="brand" value="<%= product.brand %>">
                <label>category:</label>
                <input class="input-field" type="text" name="category" value="<%= product.category || '' %>">
                <label>description:</label>
                <input class="input-field" type="text" name="ddescription" value="<%= product.description || '' %>">

                <h3>Sizes:</h3>
                <label >X-small</label>
                <input class="input-field" type="number" name="sizes[xsmall]" value="<%= product.sizes.xsmall %>">
                <label>small:</label>
                <input class="input-field" type="number" name="sizes[small]" value="<%= product.sizes.small %>">
                <label>medium:</label>
                <input class="input-field" type="number" name="sizes[medium]" value="<%= product.sizes.medium %>">
                <label>large:</label>
                <input class="input-field" type="number" name="sizes[large]" value="<%= product.sizes.large %>">
                <label>X-large:</label>
                <input class="input-field" type="number" name="sizes[xlarge]" value="<%= product.sizes.xlarge %>">
                <button type="submit" class="submit-btn">Update</button>
            </form>
            <form action="/delete_product/<%= product._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?')">
                <button type="submit" class="delete-btn">Delete</button>
            </form>
        </div>
    <% }) %>
</body>
</html>